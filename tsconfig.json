{
  "compilerOptions": {
    "strict": true,
    "types": [],
    "module": "ESNext",
    "target": "es2018",
    "allowJs": false,
    "strictPropertyInitialization": false,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["dom", "es2022", "es2022.intl"],
    "esModuleInterop": true
  },
  "include": ["**/*.ts", "**/*.mts"]
}
