{
	"name": "yuhanbo-autocomplete",
	"version": "1.0.10",
	"description": "中文优先的 Obsidian 自动补全插件",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"typecheck": "tsgo -noEmit -skipLibCheck",
		"build": "pnpm typecheck && node esbuild.config.mjs production",
		"format": "prettier -l \"**/*.ts\"",
		"test": "jest --coverage",
		"test:watch": "jest --watch",
		"mobile:check": "node esbuild.config.mjs production --bundle --platform=browser",
		"pre:push": "pnpm typecheck && pnpm format && pnpm test",
		"verify": "pnpm typecheck && pnpm format && pnpm test --runInBand && pnpm build",
		"release:prepare": "node scripts/prepare-release.mjs --sync-manifest",
		"security": "python scripts/security-scan.py . --severity high --no-color"
	},
	"keywords": [],
	"author": "Yuhanbo Yu (based on tadashi-aikawa)",
	"license": "MIT",
	"devDependencies": {
		"@jest/globals": "30.5.2",
		"@typescript/native-preview": "7.0.0-dev.20260117.1",
		"chokidar": "5.0.0",
		"esbuild": "0.27.2",
		"jest": "30.5.2",
		"obsidian": "1.11.4",
		"prettier": "3.8.0",
		"prettier-plugin-organize-imports": "4.3.0",
		"tslib": "2.8.1",
		"typescript": "5.9.3"
	},
	"dependencies": {
		"chinese-tokenizer": "github:tadashi-aikawa/chinese-tokenizer",
		"emoji-regex": "10.6.0",
		"minimatch": "11.0.8",
		"ts-deepmerge": "8.0.0"
	},
	"packageManager": "pnpm@10.4.0",
	"pnpm": {
		"overrides": {
			"@babel/core@7": "7.29.6",
			"baseline-browser-mapping@2": "2.11.0",
			"browserslist@4": "4.28.7",
			"brace-expansion@2": "2.1.7",
			"test-exclude@7>glob": "14.0.2",
			"js-yaml@3": "3.15.2",
			"minimatch@9": "9.0.7",
			"obsidian>moment": "2.31.0",
			"picomatch@2": "2.3.2",
			"picomatch@4": "4.0.4",
			"glob@13": "14.0.2",
			"minimatch@10": "11.0.8"
		}
	}
}
